
const TELEGRAM_LINK = "https://t.me/jones010203";
import { useState } from "react";

export default function Admin() {
  const [city, setCity] = useState("Casablanca");
  const [hunterData, setHunterData] = useState<any>(null);
  const [verifyData, setVerifyData] = useState<any>(null);
  const [priceData, setPriceData] = useState<any>(null);
  const [loading, setLoading] = useState("");

  const runHunter = async () => {
    setLoading("hunter");
    const res = await fetch(`/api/hunter?city=${city}`);
    const data = await res.json();
    setHunterData(data);
    setLoading("");
  };
  const runVerifier = async (u: string, f: number) => {
    setLoading("verify-"+u);
    const res = await fetch(`/api/verifier?username=${u}&followers=${f}`);
    const data = await res.json();
    setVerifyData(data);
    setLoading("");
  };
  const runPricer = async (f: number) => {
    setLoading("pricer");
    const res = await fetch(`/api/pricer?followers=${f}&niche=موضة&engagement=3.2`);
    const data = await res.json();
    setPriceData(data);
    setLoading("");
  };

  return (
    <div dir="rtl" style={{background:"#0A0A0B", minHeight:"100vh", color:"white", padding:24, fontFamily:"Tajawal"}}>
      <h1 style={{fontSize:28, fontWeight:900}}>🛰️ لوحة تحكم الـ 4 خوادم AI - سرية</h1>
      <p style={{color:"#888"}}>هذه الصفحة لك وحدك - الزبائن لا يرونها. الخوادم مجانية ولا تؤثر على الموقع.</p>
      
      <div style={{display:"grid", gridTemplateColumns:"repeat(auto-fill, minmax(260px, 1fr))", gap:16, marginTop:24}}>
        <div style={{background:"#151517", border:"1px solid #222", borderRadius:16, padding:16}}>
          <h3>🔍 1. Hunter AI - الصياد</h3>
          <p style={{fontSize:12, color:"#888"}}>يجد متاجر ميتة تلقائيا</p>
          <input value={city} onChange={e=>setCity(e.target.value)} placeholder="المدينة" style={{width:"100%", marginTop:8, padding:8, borderRadius:8, background:"#1C1C1F", border:"1px solid #333", color:"white"}} />
          <button onClick={runHunter} disabled={loading==="hunter"} style={{marginTop:8, width:"100%", background:"#00D084", color:"black", padding:10, borderRadius:999, fontWeight:"bold", border:"none"}}>{loading==="hunter" ? "يبحث..." : "ابدأ الصيد"}</button>
          {hunterData && <pre style={{marginTop:10, fontSize:11, background:"#000", padding:8, borderRadius:8, overflow:"auto"}}>{JSON.stringify(hunterData, null, 2)}</pre>}
        </div>

        <div style={{background:"#151517", border:"1px solid #222", borderRadius:16, padding:16}}>
          <h3>🛡️ 2. Verifier AI - الفاحص</h3>
          <p style={{fontSize:12, color:"#888"}}>يفحص المتابعين حقيقيين أم مزيفين</p>
          <button onClick={()=>runVerifier("bella.moda.ma",12400)} disabled={loading.includes("verify")} style={{marginTop:8, width:"100%", background:"white", color:"black", padding:10, borderRadius:999, fontWeight:"bold", border:"none"}}>افحص bella.moda.ma</button>
          {verifyData && <pre style={{marginTop:10, fontSize:11, background:"#000", padding:8, borderRadius:8}}>{JSON.stringify(verifyData, null, 2)}</pre>}
        </div>

        <div style={{background:"#151517", border:"1px solid #222", borderRadius:16, padding:16}}>
          <h3>💰 3. Pricer AI - المسعّر</h3>
          <p style={{fontSize:12, color:"#888"}}>يعطي ثمن عادل + عمولتك</p>
          <button onClick={()=>runPricer(12400)} disabled={loading==="pricer"} style={{marginTop:8, width:"100%", background:"#00D084", color:"black", padding:10, borderRadius:999, fontWeight:"bold", border:"none"}}>سعّر 12.4K متابع</button>
          {priceData && <pre style={{marginTop:10, fontSize:11, background:"#000", padding:8, borderRadius:8}}>{JSON.stringify(priceData, null, 2)}</pre>}
        </div>

        <div style={{background:"#151517", border:"1px solid #222", borderRadius:16, padding:16}}>
          <h3>🤝 4. Matcher AI - المطابق</h3>
          <p style={{fontSize:12, color:"#888"}}>يربط شاري ببائع + ضمان</p>
          <div style={{marginTop:8, fontSize:12, background:"#000", padding:8, borderRadius:8}}>
            ✅ يعمل تلقائيا عند كل طلب جديد<br/>
            ✅ يرسل عقد ضمان على تليجرام<br/>
            ✅ مجاني - لا يستهلك موارد
          </div>
          <a href={TELEGRAM_LINK} target="_blank" style={{display:"block", marginTop:8, textAlign:"center", background:"white", color:"black", padding:10, borderRadius:999, textDecoration:"none", fontWeight:"bold"}}>فتح تليجرام</a>
        </div>
      </div>

      <div style={{marginTop:24, background:"rgba(0,208,132,0.1)", border:"1px solid rgba(0,208,132,0.3)", borderRadius:12, padding:12}}>
        <b style={{color:"#00D084"}}>✅ الحالة: كل الخوادم الأربعة نشطة ومجانية</b><br/>
        <span style={{fontSize:12, color:"#aaa"}}>• لا تؤثر على سرعة الموقع • تستهلك 0$ • تعمل في الخلفية • آمنة 100%</span>
      </div>

      <a href="/" style={{display:"inline-block", marginTop:24, color:"#00D084"}}>← العودة للموقع الرئيسي</a>
    </div>
  );
}
